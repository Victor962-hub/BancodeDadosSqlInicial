-- FILTROS COM WHERE
-- WHERE Filtara as linha. Leia a consulta como uma frase: "Selecione os Nomes e Turmas Dos Alunos Onde a Turma Seja Igual a '2INFO-A'"

-- IGUAL A 

SELECT Nome, Turma
FROM Alunos
WHERE Turma = '2INFO-A'; 

-- Diferente de 
SELECT Nome, Turma
FROM Alunos
WHERE Turma <> '2INFO-A' -- Ou Seja, Selecione os Nomes e Turmas Dos Alunos onde a Turma seja Diferente de '2INFO-A'

-- AND: As duas condições devem ser verdadeiras para que o registro seja retornado na consulta.

SELECT Nome, Turma, DataNascimento
FROM Alunos
WHERE Turma = '2INFO-A' AND DataNascimento > '2008-01-01'; -- Ou seja, Selecione os nomes, Turmas e datas de nascimento dos alunos onde a turma seja
--igual a '2INFO-A' e a data de nascimento seja maior que '2009-01-01'

-- OR Pelo Menos uma condição deve ser verdadeira

SELECT Nome, Turma
FROM Alunos 
WHERE Turma = '2INFO-A' OR DataNascimento > '2008-01-01'; -- Ou Seja, selecione os nomes e turmas dos alunos onde a turma seja igual a '2INFO-A' 
-- Ou a data de nascimento seja maior que '2008-01-01'

-- IN: Versão mais curta para vários valores
SELECT Nome, Turma
FROM Alunos
WHERE Turma IN ('2INFO-A', '2INFO-B'); -- Ou Seja, Selecione os nomes e turmas dos alunos onde a turma seja igual a '2INFO-A' ou '2INFO-B'

-- LIKE: % Significa "Qualquer Quantidade de caracteres" E _ Significa "Qualquer caractere"

SELECT Nome, Email
FROM Alunos
WHERE Nome LIKE '%es'; -- Ou Seja, Selecione os nomes e emails dos alunos onde o email termina com '@escola.com'

